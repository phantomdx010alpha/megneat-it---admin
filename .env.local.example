# Copy this file to .env.local (which is gitignored) and fill in the real
# values from the registry Supabase project you create in Phase 1's manual
# step — see docs/PHASE_1_SETUP.md.
#
# Both of these are client-side safe: the anon key relies entirely on the
# registry project's RLS policies (exact-match-only) to stay safe to expose.
# The service-role key is NEVER put in a NEXT_PUBLIC_* var — it is only ever
# read inside server actions/API routes, starting from Phase 4.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-REGISTRY-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-registry-project-anon-key

# Added in Phase 4 — server-only (NO NEXT_PUBLIC_ prefix). Used exclusively
# inside server actions (lib/supabase/admin.js) to write to the registry's
# own projects/licenses/audit_log tables. Never sent to the browser. Get
# this from your registry project's Settings → API → service_role key.
SUPABASE_REGISTRY_SERVICE_ROLE_KEY=your-registry-project-service-role-key
